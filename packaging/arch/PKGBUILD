# Maintainer: FlowOSS <https://github.com/FlowOSS>
#
# FlowShot - screenshot + annotation for Linux (Wayland and X11).
# Internal release recipe: NOT an AUR submission. Its only consumer is the
# release workflow (.github/workflows/release.yml, package-arch job), which
# builds the `flowoss-flowshot-<ver>-1-x86_64-Arch.pkg.tar.zst` release asset
# that the AUR `flowshot-bin` package repackages. pkgrel MUST stay 1 unless
# flowshot-bin's source URL is updated in lockstep - the asset name embeds it.
#
# The `flowshot` pkgbase on the AUR belongs to a different project (which also
# installs /usr/bin/flowshot), so this package is org-qualified and family
# names are hardcoded instead of using the ${pkgname%-git} idiom.
#
# Build-dependency rationale is identical to flowshot-git; see that PKGBUILD
# (clang for bindgen, pipewire+pkgconf for the libpipewire probe, librsvg for
# the hicolor PNGs, no cmake because aws-lc-sys uses its cc builder, and
# options=('!lto') because slim C LTO objects break the aws-lc link).
pkgname=flowoss-flowshot
_pkgname=flowshot
pkgver=0.1.0
pkgrel=1
pkgdesc='Screenshot and annotation tool for Wayland and X11 with mixed-DPI support'
arch=('x86_64')
url='https://github.com/FlowOSS/flowshot'
license=('GPL-3.0-or-later')
depends=(
  'glibc'
  'libgcc'
  'libpipewire-0.3.so'
  'wayland'
  'vulkan-icd-loader'
  'fontconfig'
  'ttf-font'
  'hicolor-icon-theme'
)
makedepends=(
  'cargo'
  'clang'
  'desktop-file-utils'
  'git'          # a git source (even tag-pinned) is a VCS source per namcap
  'librsvg'
  'pipewire'
  'pkgconf'
)
checkdepends=('ttf-dejavu')
optdepends=(
  'xdg-desktop-portal: portal capture, global shortcuts and OpenURI'
  'xdg-desktop-portal-gnome: portal backend for GNOME'
  'xdg-desktop-portal-kde: portal backend for KDE Plasma (KWin ScreenShot2)'
  'xdg-desktop-portal-hyprland: portal backend for Hyprland'
  'xdg-desktop-portal-wlr: portal backend for wlroots compositors (Sway)'
  'vulkan-driver: Vulkan implementation for the GPU-accelerated overlay'
  'gnome-shell-extension-appindicator: system tray icon under GNOME'
)
# The bare `flowshot` name is provided for discoverability; pacman's
# file-conflict check on /usr/bin/flowshot prevents co-installation with the
# other project. See flowshot-git/PKGBUILD.
provides=('flowshot')
conflicts=('flowshot-git')
# Pin the tag OBJECT hash rather than the tag name (tags can be force-pushed);
# append `?signed` + validpgpkeys= once tags are signed. The release workflow
# fills this in per tag.
_tag=0000000000000000000000000000000000000000
source=("$_pkgname::git+$url.git#tag=$_tag")
# Filled by the release workflow via updpkgsums (which computes real checksums
# for git sources); it refuses to proceed while this says SKIP.
b2sums=('SKIP')
# '!debug': the CI asset needs no Arch debug split package; the split's
# dangling .build-id symlinks also trip namcap.
options=('!lto' '!debug')

prepare() {
  cd "$_pkgname"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$_pkgname"
  export CARGO_TARGET_DIR=target
  export CARGO_PROFILE_RELEASE_LTO=thin
  export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
  # Keep package builds light; the workspace profile's line-table debug info
  # is for the release pipeline's companion split, not for pacman packages
  # (makepkg strips anyway).
  export CARGO_PROFILE_RELEASE_DEBUG=false
  cargo build --release --frozen --bin flowshot --bin flowshot-daemon
  cargo build --release --frozen -p flowshot-cli --example man_pages
}

check() {
  cd "$_pkgname"
  export CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd "$_pkgname"

  install -Dm0755 target/release/flowshot "$pkgdir/usr/bin/flowshot"
  install -Dm0755 target/release/flowshot-daemon "$pkgdir/usr/bin/flowshot-daemon"

  install -Dm0644 packaging/flowshot.desktop.in \
    "$pkgdir/usr/share/applications/org.flowoss.FlowShot.desktop"
  desktop-file-validate "$pkgdir/usr/share/applications/org.flowoss.FlowShot.desktop"

  install -Dm0644 assets/logo.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.flowoss.FlowShot.svg"
  local size
  for size in 48 64 128 256 512; do
    install -dm0755 "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
    rsvg-convert -w "$size" -h "$size" assets/logo.svg \
      -o "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/org.flowoss.FlowShot.png"
  done

  ./target/release/examples/man_pages "$srcdir/man"
  install -dm0755 "$pkgdir/usr/share/man/man1" "$pkgdir/usr/share/man/man5"
  install -m0644 "$srcdir"/man/*.1 -t "$pkgdir/usr/share/man/man1/"
  install -m0644 "$srcdir"/man/*.5 -t "$pkgdir/usr/share/man/man5/"

  install -dm0755 \
    "$pkgdir/usr/share/bash-completion/completions" \
    "$pkgdir/usr/share/zsh/site-functions" \
    "$pkgdir/usr/share/fish/vendor_completions.d" \
    "$pkgdir/usr/share/elvish/lib"
  ./target/release/flowshot completions bash \
    > "$pkgdir/usr/share/bash-completion/completions/flowshot"
  ./target/release/flowshot completions zsh \
    > "$pkgdir/usr/share/zsh/site-functions/_flowshot"
  ./target/release/flowshot completions fish \
    > "$pkgdir/usr/share/fish/vendor_completions.d/flowshot.fish"
  ./target/release/flowshot completions elvish \
    > "$pkgdir/usr/share/elvish/lib/flowshot.elv"

  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 NOTICES "$pkgdir/usr/share/licenses/$pkgname/NOTICES"
  install -Dm0644 -t "$pkgdir/usr/share/doc/$pkgname/" \
    README.md docs/config-reference.md docs/dbus-api.md
}
